[Unit]
# One alert evaluation: the convergence assessment and watched unit health
# compared with the last run. Transitions go to the journal (identifier
# ffn-alert), the bounded event log, the console's dashboard and header
# badge, and the email/webhook outputs in /etc/ffn-ngfw/alerts.json.
Description=FFN NGFW alert evaluation
Documentation=file:/opt/ffn-ngfw/ffn_alerts.py
After=ffn-controld.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/ffn-ngfw/ffn_alerts.py evaluate
# Plane requests for the assessment take tens of seconds each; a stuck one
# must not pile evaluations up behind it.
TimeoutStartSec=170
ProtectHome=yes
PrivateTmp=yes
