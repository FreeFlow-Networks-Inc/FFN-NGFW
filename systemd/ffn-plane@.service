[Unit]
Description=FFN %i control-plane daemon
After=network.target

[Service]
Type=simple
User=root
UMask=0077
RuntimeDirectory=ffn-plane-%i
RuntimeDirectoryMode=0700
StateDirectory=ffn-plane/%i
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/lib/ffn/ffn_planed.py serve --config /etc/ffn/planes/%i.json --socket /run/ffn-plane-%i/control.sock --journal /var/lib/ffn-plane/%i/requests.db
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=130
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
